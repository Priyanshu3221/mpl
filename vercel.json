{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd mplads-investigator && npm run build",
  "outputDirectory": "mplads-investigator/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
